{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@workshop:facades": [
        "libs/shared/facades/src/index.ts"
      ],
      "@workshop:dal": [
        "libs/shared/dal/src/index.ts"
      ],
      "@workshop:base": [
        "libs/shared/base/src/index.ts"
      ],
      "@workshop:def:consts": [
        "libs/shared/definitions/src/constants/index.ts"
      ],
      "@workshop:def:abstracts": [
        "libs/shared/definitions/src/abstracts/index.ts"
      ],
      "@workshop:def:classes": [
        "libs/shared/definitions/src/classes/index.ts"
      ],
      "@workshop:def:enums": [
        "libs/shared/definitions/src/enums/index.ts"
      ],
      "@workshop:def:types": [
        "libs/shared/definitions/src/types/index.ts"
      ],
      "@workshop:def:interfaces": [
        "libs/shared/definitions/src/interfaces/index.ts"
      ],
      "@workshop:def:records": [
        "libs/shared/definitions/src/records/index.ts"
      ],
      "definitions": [
        "./libs/shared/definitions/src/index.ts"
      ],
      "base": [
        "./libs/shared/base/src/index.ts"
      ],
      "dal": [
        "./libs/shared/dal/src/index.ts"
      ],
      "facades": [
        "./libs/shared/facades/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
